# Модуль vypadok: детермінований генератор Парка-Міллера (той самий seed дає ту саму історію)

functia novyi_generator(zerno):
    vernuty {"stan": zerno, "vyklykiv": 0}

functia nastupne_chyslo(gen):
    gen["stan"] = matematyka.ostacha(gen["stan"] * 16807, 2147483647)
    gen["vyklykiv"] = gen["vyklykiv"] + 1
    vernuty gen["stan"]

functia vypadkove_vid_do(gen, nyz, verkh):
    vernuty nyz + matematyka.ostacha(nastupne_chyslo(gen), verkh - nyz)

functia vypadkovyi_z(gen, spysok):
    vernuty spysok[vypadkove_vid_do(gen, 0, dovzhyna(spysok))]

functia shans(gen, vidsotky):
    vernuty vypadkove_vid_do(gen, 0, 100) < vidsotky

functia drib(gen):
    vernuty nastupne_chyslo(gen) / 2147483647

functia peremishaty(gen, s):
    rez = s[:]
    i = dovzhyna(rez) - 1
    poky i > 0:
        j = vypadkove_vid_do(gen, 0, i + 1)
        t = rez[i]
        rez[i] = rez[j]
        rez[j] = t
        i = i - 1
    vernuty rez
